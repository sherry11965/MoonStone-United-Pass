{
  "name": "frontend-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:spa": "node e2e/run-e2e-spa.mjs",
    "test:e2e:ui": "playwright test --ui",
    "dev:spa": "vite",
    "build:spa": "vite build",
    "preview:spa": "vite preview"
  },
  "dependencies": {
    "@css-render/vue3-ssr": "^0.15.4",
    "@vueuse/core": "^12.5.0",
    "h3": "^1.15.0",
    "naive-ui": "^2.40.0",
    "nuxt": "^3.21.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^10.0.0",
    "happy-dom": "^17.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
