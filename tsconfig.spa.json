{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "useDefineForClassFields": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "#imports": ["./src/nuxt-compat/nuxt-imports.ts"]
    }
  },
  "include": [
    "src/**/*",
    "shared/constants.ts",
    "shared/data-source-mode.ts",
    "shared/runtime-config-adapter.ts",
    "shared/router-base.ts",
    "shared/router-base.test.ts",
    "shared/http/browser-http-client.ts",
    "shared/http/browser-http-client.test.ts",
    "shared/queries/browser-queries.ts",
    "shared/queries/browser-queries.test.ts",
    "shared/legal-publication.ts",
    "shared/legal-publication.test.ts",
    "features/auth/auth-navigation.ts",
    "features/auth/auth-navigation.test.ts",
    "features/account/composables/useAccountShellBrowser.ts",
    "features/account/composables/useAccountShellBrowser.test.ts",
    "features/admin/composables/useAdminShellBrowser.ts",
    "features/admin/composables/useAdminShellBrowser.test.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist-spa", ".output", ".nuxt"]
}
