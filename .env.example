#
# Vite SPA environment switches (P1 Nuxt → Vite migration).
#
# Build-time baking semantics: `import.meta.env.VITE_*` values are statically
# replaced by Vite at build time. Changing them requires a rebuild — unlike
# the Nuxt stack, there is no runtime override on the serving side.
#

# Single mock/real data-source switch (counterpart of NUXT_PUBLIC_USE_MOCK).
# Must only be read through the Vite-side wrapper; mirrors the legacy
# `=== "true"` semantics with no silent fallback.
VITE_USE_MOCK=false

# Public registration switch (counterpart of UP_PUBLIC_REGISTRATION_ENABLED,
# ADR-0016). "true" enables self-service registration on the login surface.
VITE_PUBLIC_REGISTRATION_ENABLED=false

# Browser-side API base URL override for edge cases (the documented default is
# the same-origin `/api/v1` prefix served through the Vite dev proxy to the
# Go backend on :8080). Leave unset to keep the default.
VITE_API_BASE_URL=
